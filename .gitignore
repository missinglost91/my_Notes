# ============================================================
# my_Notes .gitignore
# Keep notes/source files in Git; keep local caches, secrets,
# generated artifacts, large datasets, and binary build outputs out.
# ============================================================

# ---------- OS / editor ----------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.code-workspace

# ---------- Obsidian / local note app state ----------
.obsidian/

# ---------- Local assistant/tool state ----------
.claude/
.workbuddy/
checkdevice.py
pyproject.toml
uv.lock

# ---------- Secrets / local config ----------
.env
.env.*
!.env.example
*.local
*.local.*
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa
id_dsa
id_ed25519

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
.Python
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
venv/
.venv/
env/
.env/
*.egg-info/

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ---------- Node / frontend ----------
node_modules/
dist/
build/
.next/
.nuxt/
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

